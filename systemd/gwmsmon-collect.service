[Unit]
Description=gwmsmon HTCondor pool data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gwmsmon
Group=gwmsmon
Environment=PYTHONPATH=/opt/gwmsmon/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m gwmsmon.collector --verbose
WorkingDirectory=/var/lib/gwmsmon
Restart=on-failure
RestartSec=30
UMask=0022
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gwmsmon-collect
MemoryMax=50G
TasksMax=128
# Watchdog: collector must ping WATCHDOG=1 within this window or
# systemd restarts the service. Catches Pool.map / Process.join hangs
# (seen 2026-05-11: 22h silent wedge with workers stuck on futex).
WatchdogSec=600
NotifyAccess=main
# Stop quickly if SIGTERM doesn't get a clean exit — escalate to SIGKILL.
TimeoutStopSec=30
KillMode=mixed
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
